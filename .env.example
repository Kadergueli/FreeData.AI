# Configuration FreeData.AI
# Mode 1 : Développement local sur CSV (utilisé automatiquement si SUPABASE_DB_URL est vide)
FREEDATA_CSV_PATH=freedatatd-markets-full.csv

# Mode 2 : Production Supabase PostgreSQL (décommenter et renseigner)
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Mode 3 : Sécurité & CORS pour le frontend Flutter (Firebase Hosting)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,https://freedata-ai.web.app,https://freedata-ai.firebaseapp.com

# Mode 4 : Optionnel - LLM Local via Ollama pour enrichir les réponses de l'agent IA
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

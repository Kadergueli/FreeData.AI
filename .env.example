# Configuration FreeData.AI
# Copier ce fichier en .env (jamais commité) puis renseigner les valeurs.

# --- Mode 1 : développement local sur CSV ---------------------------------
# Utilisé automatiquement si SUPABASE_URL / SUPABASE_DB_URL sont vides.
FREEDATA_CSV_PATH=freedatatd-markets-full.csv

# --- Mode 2 : production Supabase via HTTPS REST (recommandé, léger en RAM) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# Clé de LECTURE de l'API : clé publique (anon / publishable). Voir sql/04_rls_policies.sql.
# SUPABASE_KEY=
# Clé d'ÉCRITURE : uniquement pour scripts/update_predictions.py. Ne JAMAIS la mettre sur l'API.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Mode 3 : PostgreSQL direct (pip install -r requirements-postgres.txt) ---
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- API ---------------------------------------------------------------------
# Origines autorisées (CORS) pour le frontend Flutter / Firebase Hosting.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,https://freedata-ai.web.app,https://freedata-ai.firebaseapp.com
# Jeton exigé (en-tête X-Admin-Token) par POST /api/v1/refresh. Vide = endpoint désactivé.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=
# Séries sans relevé depuis plus de N mois (par rapport au relevé le plus récent) : non servies. 0 = filtre désactivé.
MAX_STALENESS_MONTHS=3

# --- Optionnel : LLM & Embeddings RAG (Groq + Jina AI, 1024 dim) -------------
# Chat LLM (Groq)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_CHAT_MODEL=llama-3.3-70b-versatile
# Embeddings 1024 dim (Jina AI)
# EMBED_API_KEY=
# EMBED_BASE_URL=https://api.jina.ai/v1/embeddings
# EMBED_MODEL=jina-embeddings-v3

# --- Optionnel : LLM local (Ollama) pour reformuler les réponses de l'agent ---
# Les nombres cités par le LLM sont vérifiés ; sinon les faits du moteur sont renvoyés tels quels.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Qualité des données & routage (optionnel) --------------------------------
# 1 (défaut) : les relevés marqués OUTLIER sont écartés avant le modèle. 0 pour les conserver.
# EXCLUDE_FLAGGED_OUTLIERS=1
# 1 (défaut) : en tier premium, le LLM choisit l'analyse dans une liste fermée (1 appel supplémentaire, ~1 s).
# LLM_ROUTING=1
